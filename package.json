{
  "name": "fragment-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin Agent pour Fragment",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=cjs --external:fragment --outfile=main.js && esbuild src/serveur/agent-serveur.ts --bundle --platform=node --format=cjs --target=node24 --minify --outfile=agent-serveur.js",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "zod": "^4.6.5"
  }
}
