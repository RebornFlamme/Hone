# Copier ce fichier en .env, dans ce même dossier, et y coller la clé.
# .env est ignoré par git : il ne quitte jamais cette machine.
OPENAI_API_KEY=

# 1 : l'agent ne fait AUCUN appel à OpenAI (pas de crédits dépensés). 0 pour l'allumer.
AGENT_BLOQUE=1

# Modèles (facultatif). Le fort : chat, indice, visualiser. Le léger : définir, traduire, résumer, bilan.
AGENT_MODELE_FORT=gpt-5.4
AGENT_MODELE_LEGER=gpt-5.4-mini

# Tokens permis par session (entrée + sortie). 0 : sans plafond.
AGENT_PLAFOND_TOKENS=500000
